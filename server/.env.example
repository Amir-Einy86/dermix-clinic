# نمونه‌ی تنظیمات — این فایل را به .env کپی کنید و مقدارها را پر کنید.
# فایل .env (با مقدارهای واقعی) هرگز نباید commit شود؛ در .gitignore آمده است.
# production = انتشار روی اینترنت (کوکی امن، بدون جزئیات فنی خطا) | development = فقط روی سیستم خودتان
NODE_ENV=production
# فقط هنگام توسعه و فقط اگر لازم شد: جزئیات فنی خطا (stack) را در پاسخ API نشان می‌دهد. در production اثری ندارد.
# DEBUG_ERRORS=true
PORT=5000
# برای Nginx روی همان سرور: BIND_HOST=127.0.0.1 | در هاست ابری طبق تنظیمات هاست
BIND_HOST=
MONGODB_URI=mongodb://127.0.0.1:27017/clinic
# رشته‌ی تصادفی حداقل ۳۲ نویسه؛ برای ساخت:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h
# چند پراکسی جلوی برنامه است؟ (در production اجباری است)
#   1 = پشت Nginx یا هاست ابری (لیارا، Render و …)   |   0 = برنامه مستقیم به اینترنت وصل است
# مقدار اشتباه یعنی یا محدودیت تعداد درخواست با هدر جعلی دور زده می‌شود، یا همه‌ی کاربران یک IP دیده می‌شوند.
TRUST_PROXY=
# آدرس اصلی سایت با https:// و بدون / آخر (در production اجباری)
SITE_URL=
# در production ریدایرکت HTTPS همیشه فعال است. FORCE_HTTPS فقط برای توسعه است.
# محل ذخیره‌ی عکس‌های آپلودی (نسبت به پوشه‌ی server). روی هاستی که دیسک برنامه را با هر انتشار پاک می‌کند، مسیر دیسک دائمی را بدهید.
UPLOAD_DIR=uploads
# ---- پیامک ----
# off = بدون پیامک و رزرو آنلاین در production | kavenegar = ارسال واقعی | log = فقط توسعه
SMS_DRIVER=off
# کلید API از پنل سرویس پیامک (هرگز در گیت نگذارید)
SMS_API_KEY=
# نام قالب‌های تأییدشده در پنل کاوه‌نگار
#   OTP:      %token% = کد تأیید
#   BOOKED:   %token% = شماره پیگیری، %token2% = تاریخ، %token3% = ساعت، %token10% = شعبه
#   STATUS:   %token% = شماره پیگیری، %token10% = «تأیید شد» یا «لغو شد»
#   REMINDER: %token% = شماره پیگیری، %token2% = تاریخ، %token3% = ساعت، %token10% = شعبه
SMS_TEMPLATE_OTP=
SMS_TEMPLATE_BOOKED=
SMS_TEMPLATE_STATUS=
SMS_TEMPLATE_REMINDER=
# در production برای فعال شدن رزرو آنلاین، این گزینه باید true و سرویس پیامک واقعی فعال باشد.
SMS_OTP_REQUIRED=true
# پیامک یادآوری روز قبل از این ساعت (وقت تهران) فرستاده می‌شود
SMS_REMINDER_HOUR=10
# منطقه‌ی زمانی نوبت‌ها
CLINIC_TZ=Asia/Tehran
# سرو کردن پوشه‌ی client توسط همین سرور (برای کار کردن کوکی نشست، بهتر است true بماند)
SERVE_CLIENT=true
CLIENT_DIR=../client
MAX_UPLOAD_MB=8
# فقط اگر فرانت روی دامنه‌ی جدا میزبانی می‌شود:
CORS_ORIGIN=
# ساخت مدیر ارشد اولیه توسط seed — اگر رمز را خالی بگذارید، یک رمز تصادفی ساخته و فقط یک‌بار چاپ می‌شود (امن‌تر)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
